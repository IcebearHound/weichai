{
  "schemaVersion": "1.0",
  "requirement": "解码 MIME 编码文本(如 =?UTF-8?B?...?= 的 base64 或 =?UTF-8?Q?...?= 的 quoted-printable 形式),非编码文本原样返回;编码格式非法或输入为 null 时抛异常",
  "target": {
    "language": "Java",
    "className": "org.apache.commons.fileupload.util.mime.MimeUtility",
    "method": "decodeText",
    "isStatic": true,
    "constructorArgs": []
  },
  "cases": [
    {
      "id": "plain-passthrough",
      "description": "非编码文本原样返回",
      "inputs": [{ "type": "string", "value": "hello world" }],
      "expected": { "kind": "return", "value": { "type": "string", "value": "hello world" } }
    },
    {
      "id": "encoded-b",
      "description": "base64 编码文本解码为 UTF-8",
      "inputs": [{ "type": "string", "value": "=?UTF-8?B?aGVsbG8=?=" }],
      "expected": { "kind": "return", "value": { "type": "string", "value": "hello" } }
    },
    {
      "id": "encoded-b-cn",
      "description": "base64 编码中文解码为 UTF-8",
      "inputs": [{ "type": "string", "value": "=?UTF-8?B?5L2g5aW9?=" }],
      "expected": { "kind": "return", "value": { "type": "string", "value": "你好" } }
    },
    {
      "id": "encoded-q",
      "description": "quoted-printable 编码(=20 空格)解码",
      "inputs": [{ "type": "string", "value": "=?UTF-8?Q?hello=20world?=" }],
      "expected": { "kind": "return", "value": { "type": "string", "value": "hello world" } }
    },
    {
      "id": "encoded-q-underscore",
      "description": "quoted-printable 下划线(代表空格)解码",
      "inputs": [{ "type": "string", "value": "=?UTF-8?Q?hello_world?=" }],
      "expected": { "kind": "return", "value": { "type": "string", "value": "hello world" } }
    },
    {
      "id": "not-encoded",
      "description": "无 MIME 前缀/后缀的普通文本原样返回",
      "inputs": [{ "type": "string", "value": "plain text" }],
      "expected": { "kind": "return", "value": { "type": "string", "value": "plain text" } }
    },
    {
      "id": "malformed-no-suffix",
      "description": "只有前缀没有后缀 ?= 时原样返回",
      "inputs": [{ "type": "string", "value": "=?UTF-8?B?abc" }],
      "expected": { "kind": "return", "value": { "type": "string", "value": "=?UTF-8?B?abc" } }
    },
    {
      "id": "null-input",
      "description": "null 输入抛异常(参考实现无空值防护,C# NullReferenceException 与 Java NullPointerException 等价)",
      "inputs": [{ "type": "null", "value": null }],
      "expected": { "kind": "exception", "type": "NullPointerException" }
    }
  ]
}
