{
  "schemaVersion": "1.0",
  "requirement": "base64 字符串解码为字节数组(string → byte[])",
  "target": {
    "language": "Java",
    "className": "org.apache.commons.fileupload.util.mime.Base64Decoder",
    "method": "decode",
    "isStatic": true,
    "constructorArgs": []
  },
  "cases": [
    {
      "id": "empty",
      "description": "空字符串解码为空字节数组",
      "inputs": [{ "type": "string", "value": "" }],
      "expected": { "kind": "return", "value": { "type": "list", "value": [] } }
    },
    {
      "id": "hello",
      "description": "hello 的 base64 解码",
      "inputs": [{ "type": "string", "value": "aGVsbG8=" }],
      "expected": {
        "kind": "return",
        "value": {
          "type": "list",
          "value": [
            { "type": "number", "value": 104 },
            { "type": "number", "value": 101 },
            { "type": "number", "value": 108 },
            { "type": "number", "value": 108 },
            { "type": "number", "value": 111 }
          ]
        }
      }
    },
    {
      "id": "binary",
      "description": "二进制字节序列解码",
      "inputs": [{ "type": "string", "value": "AAECAw==" }],
      "expected": {
        "kind": "return",
        "value": {
          "type": "list",
          "value": [
            { "type": "number", "value": 0 },
            { "type": "number", "value": 1 },
            { "type": "number", "value": 2 },
            { "type": "number", "value": 3 }
          ]
        }
      }
    },
    {
      "id": "cn",
      "description": "中文 UTF-8 字节序列解码",
      "inputs": [{ "type": "string", "value": "5L2g5aW9" }],
      "expected": {
        "kind": "return",
        "value": {
          "type": "list",
          "value": [
            { "type": "number", "value": 228 },
            { "type": "number", "value": 189 },
            { "type": "number", "value": 160 },
            { "type": "number", "value": 229 },
            { "type": "number", "value": 165 },
            { "type": "number", "value": 189 }
          ]
        }
      }
    }
  ]
}
