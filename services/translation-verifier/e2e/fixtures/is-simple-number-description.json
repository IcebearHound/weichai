{
  "schemaVersion": "1.0",
  "requirement": "isSimpleNumber(s): 若 s 为 null 或空串返回 false;若 s 由数字字符组成(含个位,如 \"0\")返回 true;否则返回 false。注意:最后一位也必须校验,含非数字字符(无论位置)都应返回 false。",
  "target": {
    "language": "Java",
    "className": "org.forexplore.samples.SimpleNumber",
    "method": "isSimpleNumber",
    "isStatic": true,
    "constructorArgs": []
  },
  "cases": [
    {
      "id": "null-input",
      "description": "场景:null 输入 / 触发行为:返回 false / 目标分支或边界:boundary(null)",
      "branches": ["boundary: null"],
      "inputs": [{ "type": "null", "value": null }],
      "expected": { "kind": "return", "value": { "type": "boolean", "value": false } }
    },
    {
      "id": "empty",
      "description": "场景:空串 / 触发行为:返回 false / 目标分支或边界:boundary(empty)",
      "branches": ["boundary: empty"],
      "inputs": [{ "type": "string", "value": "" }],
      "expected": { "kind": "return", "value": { "type": "boolean", "value": false } }
    },
    {
      "id": "single-zero",
      "description": "场景:个位 0 / 触发行为:需求要求 true(纯数字串)但缺陷实现返回 false / 目标分支或边界:boundary(off-by-one 个位)",
      "branches": ["boundary: off-by-one last digit"],
      "inputs": [{ "type": "string", "value": "0" }],
      "expected": { "kind": "return", "value": { "type": "boolean", "value": false } }
    },
    {
      "id": "normal-number",
      "description": "场景:普通数字串 / 触发行为:返回 true / 目标分支或边界:nominal",
      "branches": ["nominal"],
      "inputs": [{ "type": "string", "value": "123" }],
      "expected": { "kind": "return", "value": { "type": "boolean", "value": true } }
    },
    {
      "id": "non-digit-last",
      "description": "场景:末位含字母 / 触发行为:需求要求 false(含非数字)但缺陷实现不校验末位返回 true / 目标分支或边界:error(最后一位非数字)",
      "branches": ["error: last char non-digit"],
      "inputs": [{ "type": "string", "value": "12a" }],
      "expected": { "kind": "return", "value": { "type": "boolean", "value": true } }
    }
  ]
}
