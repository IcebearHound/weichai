ADAPTATION_HOST=127.0.0.1
ADAPTATION_PORT=8788
# The VS Code extension host does not need CORS. If a browser client is
# intentionally enabled, set one explicit origin instead of '*'.
# ADAPTATION_CORS_ORIGIN=http://127.0.0.1:5173

# Required. This key is read only by adaptation-service and is never sent to Vite.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional OpenAI-compatible endpoint override.
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Optional. Defaults to fixtures/target-system/forexplore-csharp-workspace.
# ADAPTATION_SKELETON_PROJECT_PATH=/absolute/path/to/forexplore-csharp-workspace

# Optional. Backfill target; defaults to ADAPTATION_SKELETON_PROJECT_PATH.
# ADAPTATION_PROJECT_ROOT=/absolute/path/to/forexplore-csharp-workspace

# Optional. WSL auto-detects the standard Windows SDK installation path.
# DOTNET_COMMAND=/mnt/c/Program Files/dotnet/dotnet.exe
