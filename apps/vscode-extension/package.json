{
  "name": "forexplore-vscode",
  "displayName": "ForeXplore Code Translation",
  "description": "在 VSCode 中运行 ForeXplore 代码翻译工作流：检索相似实现、生成目标代码并以 diff 预览回填。",
  "version": "0.1.0",
  "publisher": "forexplore",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension/extension.js",
  "files": [
    "dist/extension/**",
    "dist/webview/**",
    "README.md"
  ],
  "activationEvents": [
    "onCommand:forexplore.startTranslation",
    "onCommand:forexplore.showPanel",
    "onCommand:forexplore.checkRepositories",
    "onCommand:forexplore.reindex",
    "onCommand:forexplore.restoreLastCheckpoint"
  ],
  "contributes": {
    "commands": [
      {
        "command": "forexplore.startTranslation",
        "title": "ForeXplore: 开始代码翻译"
      },
      {
        "command": "forexplore.showPanel",
        "title": "ForeXplore: 打开翻译面板"
      },
      {
        "command": "forexplore.checkRepositories",
        "title": "ForeXplore: 检查检索仓库"
      },
      {
        "command": "forexplore.reindex",
        "title": "ForeXplore: 重新索引检索仓库"
      },
      {
        "command": "forexplore.restoreLastCheckpoint",
        "title": "ForeXplore: 恢复最近一次回填"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "forexplore.startTranslation",
          "when": "editorHasSelection && resourceScheme == file && resourceLangId == csharp",
          "group": "forexplore@1"
        }
      ]
    },
    "configuration": {
      "title": "ForeXplore",
      "properties": {
        "forexplore.executionMode": {
          "type": "string",
          "enum": ["guided-demo", "real"],
          "enumDescriptions": [
            "使用内置样例演示完整审阅流程；结果只能预览，不能写回工作区。",
            "调用已部署的 SeekDB 检索服务和 Java → C# 适配服务；两个服务都必须健康。"
          ],
          "default": "guided-demo",
          "description": "ForeXplore 的明确运行模式。扩展不会在真实模式失败时自动降级为演示数据。"
        },
        "forexplore.repositoryPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "仅检查本地目录是否可读，不能证明该目录已被远端检索服务索引。真实检索范围由服务端部署配置决定。"
        },
        "forexplore.retrievalApiUrl": {
          "type": "string",
          "default": "",
          "description": "真实模式下的检索服务地址，如 http://127.0.0.1:8787。真实模式中不能为空。"
        },
        "forexplore.adaptationApiUrl": {
          "type": "string",
          "default": "",
          "description": "真实模式下的 Java → C# 翻译服务地址，如 http://127.0.0.1:8788。真实模式中不能为空。"
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:webview && npm run build:extension",
    "build:webview": "vite build",
    "build:extension": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test": "vitest run",
    "test:integration": "npm run build && node esbuild.integration.mjs && tsx src/test/integration/run-tests.ts",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "@forexplore/adaptation-http-adapter": "0.1.0",
    "@forexplore/contracts": "0.1.0",
    "@forexplore/mock-adapters": "0.1.0",
    "@forexplore/seekdb-adapter": "0.1.0",
    "@forexplore/workflow-core": "0.1.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
