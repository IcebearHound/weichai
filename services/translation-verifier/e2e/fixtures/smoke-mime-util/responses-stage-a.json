{
  "description": "阶段 A(离线 happy path):真实翻译产物应全部机械 pass + 语义裁决 pass。占位符由 run-smoke-e2e.ts 替换:{{SRC_RUNNER}}/{{TGT_RUNNER}}。",
  "responses": [
    {"action": "plan_smoke", "params": {"cases": [
      {"id": "plain", "intent": "非编码文本原样返回"},
      {"id": "encoded-b", "intent": "base64 编码文本解码为 UTF-8"},
      {"id": "encoded-q", "intent": "quoted-printable 编码(=20 空格)解码"},
      {"id": "invalid-charset", "intent": "非法字符集抛异常"},
      {"id": "null-input", "intent": "null 输入抛异常"}
    ]}},
    {"action": "write_runner", "params": {"side": "source", "language": "C#", "files": [{"path": "Driver.cs", "content": "{{SRC_RUNNER}}"}]}},
    {"action": "write_runner", "params": {"side": "target", "language": "Java", "files": [{"path": "SmokeRunner.java", "content": "{{TGT_RUNNER}}"}]}},
    {"action": "compile_runner", "params": {"side": "source"}},
    {"action": "compile_runner", "params": {"side": "target"}},
    {"action": "run_runner", "params": {"side": "source"}},
    {"action": "run_runner", "params": {"side": "target"}},
    {"action": "compare", "params": {}},
    {"action": "judge", "params": {"verdicts": [
      {"caseId": "plain", "decision": "pass", "reasoning": "两侧均原样返回"},
      {"caseId": "encoded-b", "decision": "pass", "reasoning": "两侧均解码为 hello"},
      {"caseId": "encoded-q", "decision": "pass", "reasoning": "两侧均解码为 hello world"},
      {"caseId": "invalid-charset", "decision": "pass", "reasoning": "非法字符集两侧均抛异常(UnsupportedCharsetException/ArgumentException 等价类)"},
      {"caseId": "null-input", "decision": "pass", "reasoning": "null 输入两侧均抛异常(NPE/NRE 等价类)"}
    ]}},
    {"action": "finish", "params": {"summary": "真实翻译产物与源侧行为一致,5 个冒烟用例全部 pass"}}
  ]
}
